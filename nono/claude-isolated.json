{
  "extends": ["jph-docker", "claude"],
  "meta": {
    "name": "claude-isolated",
    "version": "",
    "description": "Claude Code confined to its working directory, with Docker (colima agents socket) and mise Node/Python runtimes. No $HOME/code or vault access.",
    "author": null
  },
  "filesystem": {
    "allow": ["$HOME/.plannotator"],
    "read": [
      "$HOME/code/agents/jpstack/skills",
      "$HOME/.local/share/mise/installs/node",
      "$HOME/.local/share/mise/installs/python"
    ]
  },
  "network": { "listen_port": [19432] },
  "environment": { "set_vars": { "PLANNOTATOR_PORT": "19432" } },
  "workdir": {
    "access": "readwrite"
  }
}
