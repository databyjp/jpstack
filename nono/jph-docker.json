{
  "meta": {
    "name": "jph-docker",
    "version": "",
    "description": "JPH docker config for agents to be able to use Docker",
    "author": null
  },
  "filesystem": {
    "allow": [
      "$HOME/.pi-lens",
      "$HOME/.plannotator/drafts",
      "$HOME/.worktrees/",
      "$HOME/.plannotator/feedback",
      "$HOME/code",
      "$HOME/.local/share/nono-docker-client/buildx"
    ],
    "read": [
      "$HOME/.local/share/mise/installs/node",
      "$HOME/.local/share/mise/installs/python",
      "$HOME/.local/share/nono-docker-client",
      "$HOME/.worktrees",
      "$HOME/.claude"
    ],
    "allow_file": ["$HOME/.plannotator/config.json"],
    "unix_socket": ["$HOME/.colima/default/docker.sock"]
  },
  "environment": {
    "deny_vars": [
      "DOCKER_CONTEXT",
      "DOCKER_CERT_PATH",
      "DOCKER_TLS",
      "DOCKER_TLS_VERIFY"
    ],
    "set_vars": {
      "DOCKER_HOST": "unix://$HOME/.colima/default/docker.sock",
      "DOCKER_CONFIG": "$HOME/.local/share/nono-docker-client",
      "BUILDX_CONFIG": "$HOME/.local/share/nono-docker-client/buildx",
      "GH_CONFIG_DIR": "$HOME/.pi/gh"
    }
  },
  "network": {
    "credentials": ["github"]
  },
  "security": {
    "ipc_mode": "full"
  }
}
