{
  "meta": {
    "name": "jph-default",
    "version": "",
    "description": "JPH default config; includes mise-managed Node and Python runtimes",
    "author": null
  },
  "filesystem": {
    "allow": [
      "$HOME/.plannotator",
      "$HOME/.worktrees/",
      "$HOME/.codegraph/",
      "$HOME/.local/state/mise/",
      "$HOME/code",
      "$HOME/go/pkg",
      "$HOME/Documents/ObsidianVaults/jph-weaviate",
      "$HOME/Documents/ObsidianVaults/WeaviateBrain26"
    ],
    "read": [
      "$HOME/.local/share/mise",
      "$HOME/.config/mise",
      "$HOME/.agents/",
      "$HOME/.claude",
      "$HOME/.codex"
    ]
  },
  "network": {
    "listen_port": [19432]
  },
  "environment": {
    "set_vars": { "PLANNOTATOR_PORT": "19432" }
  }
}
