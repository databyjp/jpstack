{
  "meta": {
    "name": "jph-default",
    "version": "",
    "description": "JPH default config; includes mise-managed Node and Python runtimes",
    "author": null
  },
  "filesystem": {
    "allow": [
      "$HOME/.plannotator",
      "$HOME/.worktrees/",
      "$HOME/code",
      "$HOME/Documents/ObsidianVaults/jph-weaviate",
      "$HOME/Documents/ObsidianVaults/WeaviateBrain26"
    ],
    "read": [
      "$HOME/.local/share/mise/installs/node",
      "$HOME/.local/share/mise/installs/python",
      "$HOME/.local/share/mise/installs/go",
      "$HOME/.claude",
      "$HOME/.codex"
    ]
  },
  "network": {
    "listen_port": [19432],
    "credentials": ["gh_cli"],
    "custom_credentials": {
      "gh_cli": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://gh_cli",
        "env_var": "GH_TOKEN",
        "credential_format": "token {}"
      }
    }
  },
  "environment": {
    "set_vars": { "PLANNOTATOR_PORT": "19432" }
  },
  "credential_capture": {
    "gh_cli": {
      "command": ["gh", "auth", "token"],
      "timeout_secs": 5,
      "cache_ttl_secs": 900
    }
  }
}
