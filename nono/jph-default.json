{
  "meta": {
    "name": "jph-default",
    "version": "",
    "description": "JPH default config; includes mise-managed Node and Python runtimes",
    "author": null
  },
  "filesystem": {
    "deny": ["$WORKDIR/.git"],
    "allow": [
      "$HOME/.plannotator",
      "$HOME/.worktrees/",
      "$HOME/.config/",
      "$HOME/code",
      "$HOME/Documents/ObsidianVaults/jph-weaviate",
      "$HOME/Documents/ObsidianVaults/WeaviateBrain26"
    ],
    "read": [
      "$WORKDIR/.git",
      "$HOME/.local/share/mise/installs/node",
      "$HOME/.local/share/mise/installs/python",
      "$HOME/.local/share/mise/installs/go",
      "$HOME/.worktrees"
    ],
    "allow_file": ["$HOME/.plannotator/config.json"],
    "bypass_protection": ["$WORKDIR/.git"]
  },
  "network": {
    "credentials": ["github"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "env_var": "GH_TOKEN",
        "credential_format": "token {}"
      }
    }
  },
  "credential_capture": {
    "github": { "command": ["gh", "auth", "token"], "timeout_secs": 5, "cache_ttl_secs": 900 }
  }
}
