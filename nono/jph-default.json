{
  "meta": {
    "name": "jph-default",
    "version": "",
    "description": "JPH default config; includes mise-managed Node and Python runtimes",
    "author": null
  },
  "filesystem": {
    "allow": [
      "$HOME/.plannotator",
      "$HOME/.worktrees/",
      "$HOME/.codegraph/",
      "$HOME/.local/state/mise/",
      "$HOME/.agents/cron/",
      "$HOME/code",
      "$HOME/go/pkg",
      "$HOME/Documents/ObsidianVaults/jph-weaviate",
      "$HOME/Documents/ObsidianVaults/WeaviateBrain26"
    ],
    "read": [
      "$HOME/.local/share/mise",
      "$HOME/.config/mise",
      "$HOME/.agents/",
      "$HOME/.claude",
      "$HOME/.codex"
    ]
  },
  "network": {
    "listen_port": [19432],
    "open_port": [11434]
  },
  "environment": {
    "allow_vars": [
      "PATH", "HOME", "USER", "LOGNAME", "SHELL",
      "TERM", "COLORTERM", "TERM_PROGRAM", "TERM_PROGRAM_VERSION",
      "LANG", "LC_*", "TMPDIR", "TMP", "TEMP", "PI_*", "AI_AGENT",
      "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN",
      "GEMINI_API_KEY", "GOOGLE_API_KEY", "OPENROUTER_API_KEY"
    ],
    "set_vars": { "PLANNOTATOR_PORT": "19432" }
  }
}
